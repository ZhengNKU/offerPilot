# 微信商户号（10位数字）
WECHAT_PAY_MCHID=1116654081

# 微信商户API私钥（如果是文件路径则填相对或绝对路径，如 certs/apiclient_key.pem；如果直接填内容也支持）
WECHAT_PAY_PRIVATE_KEY_PATH=certs/apiclient_key.pem

# 微信商户API证书序列号（可在微信商户平台“API安全”中查看）
WECHAT_PAY_SERIAL_NO=248DA158D7DF2CB9102B0FA2E06BB7D6FD66048B

# 微信商户APIv3密钥（32位字符串，用于解密回调通知）
WECHAT_PAY_API_V3_KEY=OfferPilotPayV3SecretKey20268888

# 微信绑定的小程序或移动应用/服务号 APPID（Native支付需要关联商户的有效APPID）
WECHAT_PAY_APPID=wx3da2b55ef7b7709f

# 支付成功微信异步通知回调公网地址（必须外网可达，如 https://your-domain.com/api/billing/webhook/wechat）
WECHAT_PAY_NOTIFY_URL=https://interviewvar.com/api/billing/webhook/wechat

# 支付宝开放平台创建的应用 APPID
ALIPAY_APP_ID=2021007103645350

# 应用私钥（填文件路径如 certs/app_private_key.pem，或单行/多行私钥内容）
ALIPAY_PRIVATE_KEY_

# 支付宝公钥（注意是开放平台生成的“支付宝公钥”，而非应用公钥；填路径如 certs/alipay_public_key.pem 或公钥文本）
ALIPAY_PUBLIC_KEY_

# 是否使用沙箱环境（正式环境填 False，联调沙箱填 True）
ALIPAY_SANDBOX=False

# 支付宝异步通知回调公网地址（必须外网可达，如 https://your-domain.com/api/billing/webhook/alipay）
ALIPAY_NOTIFY_URL=https://interviewvar.com/api/billing/webhook/alipay