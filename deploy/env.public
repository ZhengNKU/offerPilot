# 面试驾到 Backend Public Configuration (服务器部署用)
#
# 这个文件是**非敏感配置**,会被 commit 到 git,Docker 容器内以 env_file 形式注入。
# 第三方 API key 走 deploy/secrets/<name> 文件(Docker secrets 挂载到 /run/secrets/),
# 由 backend/app/utils/secrets.py 启动期装载到 os.environ。
#
# 本地开发请继续用 backend/.env(完整的,不入仓)。

# ── 版本 ──
PROJECT_VERSION=V26.01

# ── Database / Redis(内网密码,放 public 是因为:
#   1) 已在 docker-compose 端口映射里固定,无外部攻击面
#   2) 拆出来要多挂一个 secret,运维复杂度增加,收益低
# ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://offerpilot:offerPilot%402026@postgres:5432/offerpilot
REDIS_URL=redis://:offerPilot%402026@redis:6379/0

# ── JWT(应用层内部签名密钥,跟第三方 API key 不是一回事)──
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# JWT_SECRET 不在此(走 deploy/secrets/jwt_secret,见 setup-secrets.sh)

# ── 对外 URL ──
PUBLIC_BASE_URL=https://interviewvar.com

# ── 第三方 base_url / model / 资源 ID(非敏感)──
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

VOLC_REALTIME_APP_KEY=PlgvMymc7f3tQnJ6
VOLC_REALTIME_RESOURCE_ID=volc.speech.dialog
VOLC_REALTIME_WSS_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue

# ── Tencent Cloud SMS / SES 配置(签名/模板 ID 非敏感)──
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_FROM_EMAIL=noreply@interviewvar.com
TENCENT_SES_FROM_NAME=面试驾到
TENCENT_SES_REPLY_TO=support@interviewvar.com
TENCENT_SES_TEMPLATE_ID=54168